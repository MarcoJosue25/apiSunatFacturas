# Variables de entorno de api-sunat. Spring no lee este archivo solo:
# defínelas en tu terminal o en tu IDE, como en saas-agent.
#
# Por defecto la aplicación apunta al servicio de pruebas (beta) de la SUNAT.
# Con el beta, el usuario y la clave son siempre MODDATOS y el RUC puede ser el tuyo.
SUNAT_URL=https://e-beta.sunat.gob.pe/ol-ti-itcpfegem-beta/billService
SUNAT_RUC=20100066603
SUNAT_USUARIO=MODDATOS
SUNAT_CLAVE=MODDATOS

# Los datos de quien emite la factura (el nombre comercial y la dirección son opcionales)
SUNAT_EMISOR_RAZON_SOCIAL=EMPRESA DE PRUEBAS SAC
SUNAT_EMISOR_NOMBRE_COMERCIAL=
SUNAT_EMISOR_DIRECCION=
SUNAT_EMISOR_ESTABLECIMIENTO=0000

# El certificado digital (.p12) con el que se firman las facturas. Van los dos o ninguno.
# Con el beta sirve cualquier certificado válido (incluso uno de prueba); en producción debe ser el registrado en la SUNAT.
SUNAT_CERTIFICADO_RUTA=
SUNAT_CERTIFICADO_CLAVE=
